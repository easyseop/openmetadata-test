{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/acgh/commit-inventory.schema.json",
  "title": "Registration preparation commit inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "range", "customizations", "net_changed_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string", "minLength": 1},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_ref", "patch_sha", "custom_ref", "custom_head_sha"],
      "properties": {
        "patch_ref": {"type": "string", "minLength": 1},
        "patch_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "custom_ref": {"type": "string", "minLength": 1},
        "custom_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "customizations": {
      "type": "object",
      "patternProperties": {
        "^BANK-OM-[0-9]{3,}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commits", "latest_commit_sha", "changed_paths"],
          "properties": {
            "commits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sha", "subject", "changed_paths"],
                "properties": {
                  "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "subject": {"type": "string"},
                  "changed_paths": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "uniqueItems": true
                  }
                }
              }
            },
            "latest_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "changed_paths": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      },
      "additionalProperties": false
    },
    "net_changed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
