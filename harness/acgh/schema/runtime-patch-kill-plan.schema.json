{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/acgh/runtime-patch-kill-plan.schema.json",
  "title": "T61 deployed counterfactual patch-kill plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "scope",
    "experiments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scope": {"const": "deployed-counterfactual-high-critical"},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customization_id",
          "without_patch_sha",
          "required_test",
          "probes",
          "target_repeats",
          "method",
          "rationale"
        ],
        "properties": {
          "customization_id": {
            "type": "string",
            "pattern": "^BANK-OM-[0-9]{3}$"
          },
          "without_patch_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "required_test": {
            "type": "string",
            "pattern": "^[^\\\\]+\\.py::[^:]+$"
          },
          "probes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^\\\\]+\\.py::[^:]+$"
            }
          },
          "target_repeats": {"type": "integer", "minimum": 2, "maximum": 5},
          "method": {"const": "predecessor-runtime-negative-control"},
          "rationale": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
