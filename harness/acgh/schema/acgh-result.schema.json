{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/acgh/acgh-result.schema.json",
  "title": "acgh-result (T15)",
  "description": "Immutable machine verdict artifact (부칙 A-1). result_digest covers canonical_payload only; observational_metadata is excluded from the digest (부칙 A-1.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_payload", "observational_metadata", "result_digest", "expected_exit_code"],
  "properties": {
    "schema_version": {"const": 1},
    "canonical_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "gates", "inputs", "harness_version"],
      "properties": {
        "verdict": {"enum": ["pass", "approval", "block", "analysis_error"]},
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "verdict", "reasons"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "verdict": {"enum": ["pass", "approval", "block", "analysis_error"]},
              "reasons": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "inputs": {
          "type": "object",
          "description": "repository-qualified inputs + patch_source_lock_digest + verifier_catalog_digest (부칙 A-1.5)."
        },
        "harness_version": {"type": "string", "minLength": 1}
      }
    },
    "observational_metadata": {
      "type": "object",
      "required": ["run_id"],
      "properties": {"run_id": {"type": "string", "minLength": 1}}
    },
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_exit_code": {"type": "integer", "enum": [0, 1, 2, 3]}
  }
}
