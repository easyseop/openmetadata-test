{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/acgh/airgap-manifest.schema.json",
  "title": "Signed air-gap transfer manifest (T94)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload",
    "signed_payload_digest",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_lock_digest", "source_commit_sha", "files"],
      "properties": {
        "release_lock_digest": {"$ref": "#/$defs/sha256Digest"},
        "source_commit_sha": {"$ref": "#/$defs/gitSha"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "size", "sha256"],
            "properties": {
              "type": {
                "enum": [
                  "git-bundle",
                  "image",
                  "helm",
                  "configuration",
                  "release-lock",
                  "checksum"
                ]
              },
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256Digest"}
            }
          }
        }
      }
    },
    "signed_payload_digest": {"$ref": "#/$defs/sha256Digest"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_identity", "path"],
      "properties": {
        "algorithm": {"enum": ["cosign", "gpg", "minisign"]},
        "key_identity": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
