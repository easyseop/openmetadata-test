{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.local/acgh/impact-memo.schema.json",
  "title": "Advisory LLM upgrade impact memo (T80)",
  "description": "Read-only, evidence-backed advice. It deliberately has no verdict, approval, deployment, command, or action field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_sha",
    "input_digest",
    "model_id",
    "prompt_version",
    "affected_customization_ids",
    "facts",
    "inferences",
    "unknowns",
    "recommended_tests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_sha": {"$ref": "#/$defs/gitSha"},
    "input_digest": {"$ref": "#/$defs/sha256Digest"},
    "model_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "affected_customization_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BANK-OM-[0-9]{3,}$"
      }
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "inferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "reference", "snapshot_sha"],
      "properties": {
        "provider": {
          "enum": [
            "git-diff",
            "release-note",
            "manifest",
            "structured-diff",
            "upgrade-watch",
            "source"
          ]
        },
        "reference": {"type": "string", "minLength": 1},
        "snapshot_sha": {"$ref": "#/$defs/gitSha"}
      }
    }
  }
}
