FROM mcr.microsoft.com/playwright/python:v1.52.0-noble

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir \
       'playwright==1.52.0' \
       'pytest>=7,<10' \
       'PyYAML>=6.0' \
       'jsonschema>=4.18' \
       'pathspec>=0.11'

COPY --chmod=755 docker/rehearsal/run_portable_contracts.sh /usr/local/bin/run-portable-contracts

ENTRYPOINT ["/usr/local/bin/run-portable-contracts"]

